#HealthBar {
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(17, 17, 17);
}

#DashCooldown {
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(17, 17, 17);
}

#XPBar {
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
    border-width: 2px;
    border-color: rgb(17, 17, 17);
}

#HealthBar .unity-progress-bar__title {
    display: none;
}

#XPBar .unity-progress-bar__title {
    display: none;
}

#HealthBar .unity-progress-bar__background {
    background-color: rgb(58, 31, 31);
    border-radius: 9px;
}

#HealthBar .unity-progress-bar__progress {
    background-color: rgb(216, 58, 58);
    border-radius: 9px;
}

#XPBar .unity-progress-bar__background {
    background-color: rgb(36, 36, 36);
    border-radius: 9px;
}

#XPBar .unity-progress-bar__progress {
    background-color: rgb(154, 154, 154);
    border-radius: 9px;
}

#DashCooldown .unity-progress-bar__background {
    background-color: rgb(36, 36, 36);
    border-radius: 9px;
}

#DashCooldown .unity-progress-bar__progress {
    background-color: rgb(154, 154, 154);
    border-radius: 9px;
}

#PauseMenu {
    display: none;
}
#EndScreen {
    display: none;
}