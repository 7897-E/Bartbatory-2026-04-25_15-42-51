.upgrade-card-container {
    flex-direction: column;
    align-items: stretch;
    margin: 5px;
    flex-shrink: 0;
}

.upgrade-button {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
    border-radius: 8px;
    padding: 12px 24px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
    width: 100%;
    margin-bottom: 0;
}

.upgrade-button:hover {
    background-color: rgba(39, 39, 39, 0.7);
}

.dropdown-description-panel {
    margin-top: 0;
    padding: 4px 0;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    border-radius: 6px;
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.dropdown-description-text {
    color: rgb(240, 240, 240);
    font-size: 18px;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    height: auto;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
}
