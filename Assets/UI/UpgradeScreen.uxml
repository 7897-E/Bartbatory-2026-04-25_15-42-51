<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: column; justify-content: center; align-self: center; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.81); align-items: center;">
        <ui:Label tabindex="-1" text="Choose An Upgrade" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TitleLabel" style="align-items: auto; align-self: center; font-size: 100%; color: rgb(202, 202, 202); width: auto; height: auto; justify-content: flex-start;" />
        <ui:VisualElement name="cards-container" style="flex-grow: 1; flex-direction: row; justify-content: center; align-self: center; margin-top: 10%; margin-right: 10%; margin-bottom: 10%; margin-left: 10%; width: 100%; height: 100%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%;" />
    </ui:VisualElement>
</ui:UXML>
