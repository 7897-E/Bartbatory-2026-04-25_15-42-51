<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="cards-container" style="flex-grow: 1; align-self: center; justify-content: flex-start; flex-direction: column; width: 100%; height: 100%; align-items: flex-start; margin-top: 10%; margin-right: 10%; margin-bottom: 10%; margin-left: 10%; background-color: rgba(0, 0, 0, 0.58); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; overflow: hidden; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);">
        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="card-title" style="width: 100%; height: auto; font-size: 100%; color: rgb(192, 192, 192);" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="card-button" style="width: 100%; height: 50%; position: relative; top: 1px; left: -2px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 100%; -unity-text-align: upper-center;" />
        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="card-description" style="width: 100%; font-size: 100%; background-color: rgba(0, 0, 0, 0); color: rgb(194, 194, 194); height: auto;" />
    </ui:VisualElement>
</ui:UXML>
